<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <?include Variables.wxi?>
  <Package Name="$(var.ProductName) $(var.MavenVersion) ($(var.InstallScope))" Manufacturer="$(var.Manufacturer)" Version="$(var.MsiVersion)" UpgradeCode="$(var.UpgradeCode)" Language="1033" Scope="$(var.WixScope)" InstallerVersion="500">
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Property Id="ARPCOMMENTS" Value="Independently maintained installer. Not endorsed or supported by the Apache Software Foundation." />
    <Property Id="ARPURLINFOABOUT" Value="$(var.RepositoryUrl)" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPHELPLINK" Value="$(var.RepositoryUrl)/issues" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLDIR]" After="CostFinalize" />
    <Feature Id="MainFeature" Title="Apache Maven" Level="1"><ComponentGroupRef Id="MavenPayload" /><ComponentRef Id="PathComponent" /></Feature>
  </Package>
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="PathComponent" Guid="{3F9B468B-5ED6-4EAA-A5BE-86E13D4ABE02}">
        <util:Environment Id="MavenBinPath" Name="PATH" Value="[INSTALLDIR]bin" Part="last" Action="set" Permanent="no" System="$(var.PathSystem)" />
        <RegistryValue Root="HKMU" Key="Software\CommunityMaven" Name="InstallPath" Value="[INSTALLDIR]" Type="string" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
